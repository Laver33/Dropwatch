

model Product {
  id        String      @id @default(cuid())
  name        String

  url         String   
  targetPrice Float    
  currentPrice Float?  
  lastChecked DateTime @default(now())
  createdAt   DateTime @default(now())

  history     PriceHistory[]

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}